# secrets and local state: never commit
.env
.env.*
.dev.vars
*.pem
*.key
secrets/
*token*.txt
*bearer*.txt
.jev/
# build output and deps
node_modules/
.wrangler/
.build/
server/vendor/
dist/
__pycache__/
*.pyc
*.tar.gz
# local eval run output: evals/run.mjs writes a fresh evals/results/<date>.json on every run; these are
# scratch, not curated evidence. The corpora (evals/*.jsonl) ARE tracked. A PR wanting a before/after
# snapshot as evidence should summarize pass/fail counts in evals/RESULTS.md and the commit message, not
# commit the full run output.
evals/results/
