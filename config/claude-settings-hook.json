{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.local/share/jev-agent-skills/hooks/honest/jev-honest-activate.js\"; exit 0", "timeout": 5 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.local/share/jev-agent-skills/hooks/honest/jev-honest-subagent.js\"; exit 0", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$HOME/.local/share/jev-agent-skills/hooks/honest/jev-honest-mode-tracker.js\"; exit 0", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          { "type": "command", "command": "$HOME/.local/share/jev-agent-skills/hooks/jev-guard-hook.sh", "timeout": 5 }
        ]
      }
    ]
  },
  "statusLine": { "type": "command", "command": "bash \"$HOME/.local/share/jev-agent-skills/hooks/jev-honest-statusline.sh\"" }
}
